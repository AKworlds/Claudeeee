# Copy to .env (cp .env.example .env). Never commit .env.

# Public hostname pointing at your VPS (A record). Caddy gets a Let's Encrypt cert for it.
DASH_DOMAIN=dash.example.com

# App login (the dashboard has its own sign-in page; there is no username).
# 1) Make the password hash (prompts twice, prints a line starting with "scrypt$"):
#      docker compose -f deploy/docker-compose.yml run --rm -w /srv/dashboard/backend app python -m app.auth hash
# 2) Paste it below. The hash contains "$" separators: in this file every "$" must be doubled to "$$"
#    so docker compose does not treat it as variable interpolation.
#    e.g. scrypt$32768$8$1$salt$hash  ->  DASH_PASSWORD_HASH=scrypt$$32768$$8$$1$$salt$$hash
DASH_PASSWORD_HASH=
# 3) Cookie signing key (random):  docker compose -f deploy/docker-compose.yml run --rm -w /srv/dashboard/backend app python -m app.auth secret
#    (no "$" in it, so no escaping). Changing it signs everyone out.
DASH_SECRET_KEY=

# Optional: raises GitHub API rate limit (a read-only token with no scopes is enough).
GITHUB_TOKEN=

# Optional: job-email sync over IMAP. For Gmail use an app password
# (Google Account > Security > 2-Step Verification > App passwords).
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Optional: auto-sync the workbook from Google Drive (see README "Auto-sync from Google Drive").
# Path inside the container to the service-account JSON key (host file: secrets/google-service-account.json in the repo root).
# Also set workbook.drive_file_id in config/dashboard.yaml.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google-service-account.json
