# Copy to .env (cp .env.example .env). Never commit .env.

# Public hostname pointing at your VPS (A record). Caddy gets a Let's Encrypt cert for it.
DASH_DOMAIN=dash.example.com

# Basic-auth login protecting the whole dashboard.
DASH_USER=amadu
# Generate with:  docker run --rm caddy:2.8 caddy hash-password
# The hash contains "$" characters: in this file every "$" must be doubled to "$$"
# so docker compose does not treat it as variable interpolation.
# e.g. hash $2a$14$abc...  ->  DASH_PASSWORD_HASH=$$2a$$14$$abc...
DASH_PASSWORD_HASH=

# Optional: raises GitHub API rate limit (a read-only token with no scopes is enough).
GITHUB_TOKEN=

# Optional: job-email sync over IMAP. For Gmail use an app password
# (Google Account > Security > 2-Step Verification > App passwords).
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Optional: auto-sync the workbook from Google Drive (see README "Auto-sync from Google Drive").
# Path inside the container to the service-account JSON key (host file: secrets/google-service-account.json in the repo root).
# Also set workbook.drive_file_id in config/dashboard.yaml.
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google-service-account.json
